{
  "name": "FindTrail",
  "short_name": "FindTrail",
  "description": "A calm, practical trail for finding misplaced things.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#f7f1e7",
  "theme_color": "#173a34",
  "orientation": "portrait-primary",
  "categories": ["utilities", "productivity", "lifestyle"],
  "icons": [
    { "src": "./icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Start a search", "short_name": "Find something", "url": "./?start=1", "icons": [{ "src": "./icon-192.png", "sizes": "192x192" }] },
    { "name": "Take a reset", "short_name": "Reset", "url": "./?screen=calm", "icons": [{ "src": "./icon-192.png", "sizes": "192x192" }] }
  ]
}
